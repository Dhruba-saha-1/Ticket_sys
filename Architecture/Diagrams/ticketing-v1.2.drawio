<mxCell id="5" value="&lt;b&gt;Web — Next.js App Router&lt;/b&gt;&lt;br&gt;Super Admin · Project Head&lt;br&gt;Member · Customer&lt;br&gt;TanStack Query · shared Zod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="160" width="420" height="110" as="geometry"/></mxCell>
