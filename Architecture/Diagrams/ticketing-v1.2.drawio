        <mxCell id="2" value="Ticketing platform — system architecture (v1.2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1A365D;strokeColor=#1A365D;fontColor=#FFFFFF;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="44" as="geometry"/></mxCell>
<mxCell id="3" value="One Express API for every client. Next.js is UI only. Mobile is post-v1. Hosted on one GoDaddy/Hostinger VPS." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#4A5568;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="1520" height="28" as="geometry"/></mxCell>
