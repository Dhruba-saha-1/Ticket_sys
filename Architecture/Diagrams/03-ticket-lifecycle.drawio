<mxCell id="20" value="&lt;b&gt;Assign / unassign&lt;/b&gt;&lt;br&gt;SA or Project Head · any non-closed ticket&lt;br&gt;assignee must be role &lt;b&gt;member&lt;/b&gt; in that project" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="360" height="120" as="geometry"/></mxCell>
<mxCell id="21" value="&lt;b&gt;Resource rules&lt;/b&gt;&lt;br&gt;Customer edits own, not closed&lt;br&gt;Member status only if assigned&lt;br&gt;Customer list = own unless customerSeesAllTickets&lt;br&gt;Read-only project → 409 PROJECT_READ_ONLY" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="430" y="400" width="400" height="120" as="geometry"/></mxCell>
<mxCell id="22" value="&lt;b&gt;Deferred post-v1&lt;/b&gt;&lt;br&gt;Comments · attachments · activity timeline&lt;br&gt;No object storage in v1. Audit = createdAt / updatedAt only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="400" width="400" height="120" as="geometry"/></mxCell>
<mxCell id="23" value="&lt;b&gt;Display ID&lt;/b&gt;&lt;br&gt;Mongo $inc project.ticketSeq&lt;br&gt;PAY-0001 (4-digit pad, then grows)&lt;br&gt;unique (projectId, displayId) · key unique" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1290" y="400" width="270" height="120" as="geometry"/></mxCell>
<mxCell id="24" value="&lt;b&gt;Project statuses (separate):&lt;/b&gt; todo · ongoing · completed · on_hold · scrapped. completed / scrapped / past endDate → project is read-only. Invalid ticket transition → 409 INVALID_TRANSITION. Missing assignee into in_progress → 409 ASSIGNEE_REQUIRED." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1520" height="70" as="geometry"/></mxCell>
<mxCell id="25" value="Who can change status" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1A365D;strokeColor=#1A365D;fontColor=#FFFFFF;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1520" height="44" as="geometry"/></mxCell>
