NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/ticketing
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-32-chars-min
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-32-chars
# Local: Mailpit. Production: smtp.hostinger.com / smtpout.secureserver.net (465 SSL or 587 STARTTLS)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ticketing <no-reply@yourdomain.com>"
# Comma-separated list allowed by CORS; the first is used in email links.
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-please
