{
  "name": "@ticketing/api",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx --env-file=../../.env src/scripts/seed.ts",
    "seed:prod": "node dist/scripts/seed.js",
