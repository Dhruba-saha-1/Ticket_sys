{
  // Editor, typecheck and Jest: covers src + tests. Builds use tsconfig.build.json.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "types": ["node", "jest"],
    // Resolve shared from source so tests and the editor never need a prior build.
    "paths": { "@ticketing/shared": ["../../packages/shared/src/index.ts"] }
  },
  "include": ["src", "tests"]
}
